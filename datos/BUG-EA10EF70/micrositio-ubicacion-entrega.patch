+import { TestBed } from '@angular/core/testing';
+import { provideHttpClient } from '@angular/common/http';
+import { HttpTestingController, provideHttpClientTesting } from '@angular/common/http/testing';
+import { K2ApiService, TitularTicket } from './k2-api.service';
+
+describe('K2ApiService.crearTicket', () => {
+  let svc: K2ApiService;
+  let http: HttpTestingController;
+  const titular: TitularTicket = {
+    nombreCompleto: 'ANA PEREZ', telefono: '8100000000', correo: 'a@b.com',
+    estado: 'NUEVO LEON', municipio: 'MONTERREY', codigoPostal: '64000',
+  };
+
+  beforeEach(() => {
+    TestBed.configureTestingModule({ providers: [provideHttpClient(), provideHttpClientTesting()] });
+    svc = TestBed.inject(K2ApiService);
+    http = TestBed.inject(HttpTestingController);
+  });
+
+  afterEach(() => http.verify());
+
+  function bodyDe(t: TitularTicket) {
+    svc.crearTicket(null, 'Q2|50027051', 1, 3, t).subscribe();
+    const req = http.expectOne((r) => r.method === 'POST' && r.url.endsWith('/tickets'));
+    req.flush({ data: {} });
+    return req.request.body;
+  }
+
+  it('manda la ubicación de entrega en la boleta cuando el asegurado la captura', () => {
+    const body = bodyDe({ ...titular, estadoEntregaId: 14, municipioEntregaId: 571 });
+    expect(body.boleta_informativa).toEqual({
+      motivo_servicio_id: 3, estado_entrega_id: 14, municipio_entrega_id: 571,
+    });
+    expect(body.ubicacion_titular.estado).toBe('NUEVO LEON');
+  });
+
+  it('no manda ubicación de entrega si el auto se requiere en la dirección de la póliza', () => {
+    expect(bodyDe(titular).boleta_informativa).toEqual({ motivo_servicio_id: 3 });
+  });
+});
