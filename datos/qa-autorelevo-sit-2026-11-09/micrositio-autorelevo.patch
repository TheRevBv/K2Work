@@ -0,0 +1,111 @@
+import { Page, expect } from '@playwright/test';
+import { execFileSync } from 'node:child_process';
+import { existsSync, mkdirSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
+import { join } from 'node:path';
+
+/** Póliza de `polizas-prueba.txt`; se sobreescribe por variables de entorno. */
+export const POLIZA = process.env['POLIZA'] ?? 'CE50002775';
+export const INCISO = process.env['INCISO'] ?? '1';
+export const NUM_ASEGURADO = process.env['NUM_ASEGURADO'] ?? '18770895';
+export const OTP_FILE = process.env['OTP_FILE'] ?? join(__dirname, '..', '..', 'otp.txt');
+export const SESION_FILE = process.env['SESION_FILE'] ?? join(__dirname, '..', '..', '.auth', 'sesion-qa.json');
+/** Ruta a bin/k2-sql de K2Work; si existe, el OTP se lee de web_service_log en dev. */
+const K2_SQL = process.env['K2_SQL'] ?? join(process.env['HOME'] ?? '', 'Código/personal/K2Work/bin/k2-sql');
+export const EVIDENCIA = process.env['OUT_DIR'] ?? join(__dirname, '..', '..', 'test-output', 'qa');
+
+export async function evidencia(page: Page, bug: string, nombre: string): Promise<void> {
+  mkdirSync(join(EVIDENCIA, bug), { recursive: true });
+  await page.screenshot({ path: join(EVIDENCIA, bug, `${nombre}.png`), fullPage: true });
+}
+
+/**
+ * API_FROM=https://host-compilado API_TO=https://host-real: reenvía el API cuando el build
+ * trae un k2ApiUrl distinto al despliegue que se prueba (evita CORS).
+ */
+async function redirigirApi(page: Page): Promise<void> {
+  const from = process.env['API_FROM'];
+  const to = process.env['API_TO'];
+  if (!from || !to) return;
+  await page.route(`${from}/**`, async (route) => {
+    const res = await route.fetch({ url: route.request().url().replace(from, to) });
+    await route.fulfill({ response: res, headers: { ...res.headers(), 'access-control-allow-origin': '*' } });
+  });
+}
+
+function sql(q: string): string {
+  return execFileSync(K2_SQL, ['dev', '-e', q], { encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore'] });
+}
+
+function ultimoLogId(): number {
+  return Number(sql('SELECT MAX(id) FROM web_service_log').match(/\d+/g)?.pop() ?? 0);
+}
+
+async function otpDesdeBd(desdeId: number): Promise<string> {
+  for (;;) {
+    const out = sql(`SELECT request_ FROM web_service_log WHERE id > ${desdeId} AND name = 'SMS_TRANSACTION' ORDER BY id DESC LIMIT 1`);
+    const code = out.match(/es: (\d{6})/)?.[1];
+    if (code) return code;
+    await new Promise((r) => setTimeout(r, 3000));
+  }
+}
+
+let logIdAntesDeEnviar = 0;
+
+/** Llena login y pide el código por SMS; deja la página en /auth/otp. */
+export async function hastaOtp(page: Page): Promise<void> {
+  rmSync(OTP_FILE, { force: true });
+  await redirigirApi(page);
+  await page.goto('auth/login');
+  await page.locator('#numPoliza').fill(POLIZA);
+  await page.locator('#inciso').fill(INCISO);
+  await page.locator('#numAsegurado').fill(NUM_ASEGURADO);
+  await page.locator('form button[type="submit"]').click();
+  await page.waitForURL(/verificacion|otp/, { timeout: 60_000 });
+  if (page.url().includes('verificacion')) {
+    await page.locator('app-selection-card').first().click();
+    if (existsSync(K2_SQL)) logIdAntesDeEnviar = ultimoLogId();
+    await page.getByRole('button', { name: 'Enviar código' }).click();
+  }
+  await page.waitForURL(/auth\/otp/, { timeout: 60_000 });
+}
+
+/** Espera el OTP tecleado en la ventana (--headed) o escrito en OTP_FILE. */
+export async function capturarOtp(page: Page): Promise<void> {
+  console.log(`>>> Teclea el OTP en el navegador o escríbelo en ${OTP_FILE}`);
+  const manual = page.waitForURL((u) => !u.pathname.includes('/auth/otp'), { timeout: 10 * 60_000 });
+  const archivo = (async () => {
+    for (;;) {
+      if (existsSync(OTP_FILE)) {
+        const code = readFileSync(OTP_FILE, 'utf8').replace(/\D/g, '');
+        if (code.length === 6) return code;
+      }
+      await new Promise((r) => setTimeout(r, 1000));
+    }
+  })();
+  const fuentes: Promise<string | null>[] = [manual.then(() => null), archivo];
+  if (logIdAntesDeEnviar) fuentes.push(otpDesdeBd(logIdAntesDeEnviar));
+  const r = await Promise.race(fuentes);
+  if (r) await page.locator('input[inputmode="numeric"]').first().focus().then(() => page.keyboard.type(r));
+  await page.waitForURL(/solicitud|estado/, { timeout: 60_000 });
+}
+
+/** Login completo; termina en /estado o /estado/sucursal si la póliza tiene folio activo. */
+export async function loginConFolio(page: Page): Promise<void> {
+  if (existsSync(SESION_FILE)) {
+    const datos = readFileSync(SESION_FILE, 'utf8');
+    await redirigirApi(page);
+    await page.addInitScript((d) => {
+      if (sessionStorage.getItem('__e2e')) return;
+      sessionStorage.setItem('__e2e', '1');
+      for (const [k, v] of Object.entries(JSON.parse(d) as Record<string, string>)) sessionStorage.setItem(k, v);
+    }, datos);
+    await page.goto('estado');
+    if (!page.url().includes('auth')) return;
+    rmSync(SESION_FILE);
+  }
+  await hastaOtp(page);
+  await capturarOtp(page);
+  mkdirSync(join(SESION_FILE, '..'), { recursive: true });
+  writeFileSync(SESION_FILE, await page.evaluate(() => JSON.stringify({ ...sessionStorage })));
+  await expect(page, 'la póliza debe tener un folio activo (usa POLIZA/NUM_ASEGURADO)').toHaveURL(/\/estado/);
+}
