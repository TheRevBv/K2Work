@@ -0,0 +1,94 @@
+import { test, expect, Page } from '@playwright/test';
+import { evidencia, hastaOtp, loginConFolio } from './sesion';
+
+/**
+ * Bugs SIT del micrositio de autorelevo. El OTP llega al teléfono/correo de la póliza:
+ *   BASE_URL=https://micrositio-autorelevo-web-dot-morfeo-test.ue.r.appspot.com \
+ *     npx playwright test -c autorelevo-e2e qa/ --project=chromium --headed --workers=1
+ */
+test.setTimeout(15 * 60_000);
+
+test('BUG-87293BEC: el timer corre tras reenviar con el código expirado', async ({ page }) => {
+  await page.clock.install();
+  await hastaOtp(page);
+  const timer = page.locator('.of-timer');
+
+  await page.clock.runFor(10_000);
+  await expect(timer, 'control: el primer conteo sí corre').toContainText('4:50');
+  await page.clock.runFor('04:51');
+  await expect(timer).toContainText('Código expirado');
+
+  await page.getByRole('button', { name: 'Reenviar código' }).click();
+  await expect(timer).toContainText('5:00');
+  await page.clock.runFor(10_000);
+  await expect(timer).toContainText('4:50');
+  await evidencia(page, 'BUG-87293BEC', 'timer-tras-reenvio');
+
+});
+
+test.describe('con folio activo (un solo OTP)', () => {
+  test.describe.configure({ mode: 'serial' });
+  let page: Page;
+  let locations: Promise<import('@playwright/test').Response>;
+
+  async function irASucursal(): Promise<void> {
+    if (page.url().includes('/estado/sucursal')) return;
+    await page.goto('estado');
+    await page.getByRole('button', { name: 'Seleccionar sucursal' }).click();
+    await page.waitForURL(/estado\/sucursal/);
+  }
+
+  test.beforeAll(async ({ browser, baseURL }) => {
+    page = await browser.newPage({ baseURL });
+    locations = page.waitForResponse((r) => r.url().includes('locations'), { timeout: 5 * 60_000 });
+    await loginConFolio(page);
+    if (!page.url().includes('/estado/sucursal')) {
+      await page.getByRole('button', { name: 'Seleccionar sucursal' }).click();
+    }
+  });
+
+  test.afterAll(() => page?.close());
+
+  test('BUG-90FD668C: carga la lista de sucursales', async () => {
+    const res = await locations;
+    await evidencia(page, 'BUG-90FD668C', 'sucursales');
+    expect(res.status(), `GET ${res.url()}`).toBeLessThan(400);
+    await expect(page.getByText('Cargando sucursales disponibles')).toBeHidden({ timeout: 30_000 });
+    await expect(page.locator('.su-loc-name, select#sucursal option').first()).toBeVisible();
+  });
+  
+  test('BUG-435440F4: campos de fecha y hora completos y alineados', async () => {
+    await irASucursal();
+    const sucursal = page.locator('select#sucursal');
+    if (await sucursal.isVisible()) await sucursal.selectOption({ index: 1 });
+    await page.getByRole('button', { name: 'Continuar' }).click();
+    await page.waitForURL(/solicitud\/vehiculo/);
+  
+    const campos = page.locator('#fechaInicio, #fechaFin, #hora');
+    await expect(campos).toHaveCount(3);
+    const cajas = await Promise.all((await campos.all()).map((c) => c.boundingBox()));
+    for (const [i, c] of (await campos.all()).entries()) {
+      const recortado = await c.evaluate((el: HTMLInputElement) => el.scrollWidth > el.clientWidth);
+      expect(recortado, `campo ${i} recortado`).toBe(false);
+    }
+    expect(Math.abs(cajas[0]!.height - cajas[2]!.height), 'misma altura').toBeLessThanOrEqual(1);
+    await evidencia(page, 'BUG-435440F4', 'fechas-hora');
+  });
+  
+  test('BUG-52C30DF7: Regresar confirma, cierra sesión y vuelve al inicio', async () => {
+    await irASucursal();
+    let confirmo = false;
+    page.once('dialog', (d) => { confirmo = true; void d.accept(); });
+  
+    await page.getByRole('button', { name: 'Regresar' }).click();
+    const modal = page.getByRole('dialog');
+    if (await modal.isVisible().catch(() => false)) {
+      confirmo = true;
+      await modal.getByRole('button', { name: /s[ií]|aceptar|salir|confirmar/i }).click();
+    }
+    await evidencia(page, 'BUG-52C30DF7', 'tras-regresar');
+    expect(confirmo, 'debe pedir confirmación').toBe(true);
+    await expect(page).not.toHaveURL(/\/estado/);
+    expect(await page.evaluate(() => sessionStorage.getItem('ar_session'))).toBeNull();
+  });
+});
diff --git a/autorelevo-e2e/src/qa/sesion.ts b/autorelevo-e2e/src/qa/sesion.ts
new file mode 100644
index 0000000..4a6b5ab
