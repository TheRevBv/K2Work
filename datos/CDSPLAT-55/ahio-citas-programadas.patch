+                provider=provider,
+                provider_site=provider_site,
+                coverage_id=coverage_id
+            )
+        return
+
+    strategy_cls = AHIOFactory().factory(AhioStrategyCode.AHIO_ASSIGN_APPOINTMENT)
+    last_ticket = get_last_ticket_by_case_id(case_id=case["case_id"])
+    strategy = strategy_cls().set_data({"idServicio": case["ahio_service_id"]}).set_main_ticket(last_ticket).set_case()
+    strategy.execute()
+
+
+def trigger_appointment_assignments():
+    """Dispara la asignación de proveedor para citas cuya hora programada ya está
+    dentro de la ventana de 1.5 horas antes de fechaHoraCita."""
+    api = AHIOWrapper(config.AHIO_BASE_URL, config.AHIO_AUTH_TOKEN)
+    window_end = datetime.now(timezone.utc) + APPOINTMENT_TRIGGER_WINDOW
+
+    pending_cases = get_pending_appointment_cases(window_end=window_end)
+    for case in pending_cases:
+        try:
+            _assign_appointment_case(case, api)
+        except Exception as e:
+            logging.error(e)
