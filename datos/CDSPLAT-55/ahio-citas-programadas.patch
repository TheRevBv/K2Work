From 0af39548327c116f1de883dd3e69e913887affd6 Mon Sep 17 00:00:00 2001
From: Joshua Morin <joshua.morinsalazar@chubb.com>
Date: Mon, 27 Jul 2026 16:44:29 -0600
Subject: [PATCH 05/11] feat(ahio): agregar query para encontrar citas
 pendientes de disparar en la ventana definida

---
 apiserver/ix/apps/ahio/queries.py | 44 +++++++++++++++++++++++++++++++
 1 file changed, 44 insertions(+)

diff --git a/apiserver/ix/apps/ahio/queries.py b/apiserver/ix/apps/ahio/queries.py
index 8d46a92c..42200dd0 100644
--- a/apiserver/ix/apps/ahio/queries.py
+++ b/apiserver/ix/apps/ahio/queries.py
@@ -89,3 +89,47 @@ def get_ahio_service_id(case_id: int):
         return None
     return ticket.comment.split(AHIO_ID_PREFIX)[1].strip()
 
+
+AHIO_CITA_ID_PREFIX = "AHIO_CITA_ID:"
+
+
+def get_pending_appointment_cases(window_end: datetime) -> list:
+    """Casos con cita registrada en AHIO, aún sin proveedor asignado, cuya hora programada
+    ya está dentro de la ventana de disparo (datetime del ticket PROGRAMMED <= window_end)."""
+    assigned_ticket = aliased(AssistanceTicket)
+    programmed_ticket = aliased(AssistanceTicket)
+
+    rows = (
+        g.s()
+        .query(
+            AssistanceTicket.case_id,
+            AssistanceTicket.service_id,
+            AssistanceTicket.comment,
+        )
+        .join(AssistanceCase, AssistanceCase.id == AssistanceTicket.case_id)
+        .filter(
+            AssistanceTicket.comment.contains(AHIO_CITA_ID_PREFIX),
+            AssistanceCase.status == AssistanceCase.STATUS_OPEN,
+            ~exists().where(
+                (assigned_ticket.case_id == AssistanceTicket.case_id)
+                & (assigned_ticket.comment.contains(AHIO_ID_PREFIX))
+            ),
+            exists().where(
+                (programmed_ticket.case_id == AssistanceTicket.case_id)
+                & (programmed_ticket.ticket_type == AssistanceTicket.PROGRAMMED)
+                & (programmed_ticket.datetime <= window_end)
+            ),
+        )
+    )
+
+    results = []
+    for row in rows:
+        ahio_id = row[2].split(AHIO_CITA_ID_PREFIX)[1].strip()
+        results.append({
+            "case_id": row[0],
+            "service_id": row[1],
+            "ahio_service_id": ahio_id,
+        })
+
+    return results
+
-- 
