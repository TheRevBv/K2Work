 from ix.models.assistanceticket import AssistanceTicket
 
 
@@ -150,3 +154,42 @@ def _create_ahio_ticket(case, ticket_type, comment, user_id, date_time):
     new_ticket.add()
     g.s().flush()
     g.s().commit()
+
+
+APPOINTMENT_TRIGGER_WINDOW = timedelta(hours=1.5)
+
+
+def _assign_appointment_case(case, api):
+    response = api.get_service(case["ahio_service_id"])
+    sap_code = response.get(AhioDefinitions.RESPONSE, {}).get(AhioDefinitions.CRANE, {}).get(AhioDefinitions.SAP_CODE)
+
+    if sap_code:
+        provider, provider_site, coverage_id = get_provider_coverage_site_by_sap_code(sap_code=sap_code)
