@@ -0,0 +1,50 @@
+from ix.apps.ahio.builder import AHIOProviderAssignmentBuilder
+from ix.apps.ahio.strategies.interface import AHIOStrategyInterface
+from ix.apps.ahio.utils import get_provider_coverage_site_by_sap_code
+from ix.apps.ahio.variables import AhioDefinitions
+from ix.apps.providers.services import assign_provider
+from ix.apps.providers.types import ProviderAssignmentResult
+
+
+class AhioAssignAppointmentService(AHIOStrategyInterface, AHIOProviderAssignmentBuilder):
+
+    def __trigger_assignment(self):
+        id_servicio = self.data.get("idServicio")
+        return self.api_ahio.assign_appointment_service(id_servicio)
+
+    def __fetch_assigned_sap_code(self):
+        id_servicio = self.data.get("idServicio")
+        response = self.api_ahio.get_service(id_servicio)
+        return (
+            response
+            .get(AhioDefinitions.RESPONSE, {})
+            .get(AhioDefinitions.CRANE, {})
+            .get(AhioDefinitions.SAP_CODE)
+        )
+
+    def execute(self, *args, **kwargs) -> ProviderAssignmentResult:
+        """Dispara la asignación de una cita en AHIO y, si ya hay proveedor, la registra en K2."""
+        self.__trigger_assignment()
+        sap_code = self.__fetch_assigned_sap_code()
+
+        if not sap_code:
+            return ProviderAssignmentResult(
+                success=False,
+                message="AHIO aún no asigna proveedor para la cita"
+            )
+
+        provider, provider_site, coverage_id = get_provider_coverage_site_by_sap_code(sap_code=sap_code)
+        if not (provider and provider_site and coverage_id):
+            return ProviderAssignmentResult(
+                success=False,
+                message=f"No se encontró un proveedor en K2 para caso {self.assistance_case.id}"
+            )
+
+        ahio_response = self.api_ahio.get_service(self.data.get("idServicio"))
+        return assign_provider(
+            case_id=self.assistance_case.id,
+            ahio_response=ahio_response,
+            provider=provider,
+            provider_site=provider_site,
+            coverage_id=coverage_id
+        )
diff --git a/apiserver/ix/apps/ahio/wrapper.py b/apiserver/ix/apps/ahio/wrapper.py
index 8d6605a0..c1821b8b 100644
--- a/apiserver/ix/apps/ahio/wrapper.py
+++ b/apiserver/ix/apps/ahio/wrapper.py
@@ -79,3 +79,7 @@ class AHIOWrapper(AHIOService):
 
     def accept_service(self, payload):
         return self.post("integracion/servicios/aceptar-servicio", payload)
+
+    def assign_appointment_service(self, service_id):
+        data = {"idServicio": service_id}
+        return self.put("integracion/servicios/asignar-servicio-cita", data)
