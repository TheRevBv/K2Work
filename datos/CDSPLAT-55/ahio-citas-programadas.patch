@@ -1,4 +1,5 @@
 import logging
+from datetime import datetime
 
 from ix.apps.ahio.builder import AHIOProviderAssignmentBuilder
 from ix.apps.ahio.strategies.interface import AHIOStrategyInterface
@@ -15,6 +16,21 @@ logger = logging.getLogger(__name__)
 
 class ProposeService(AHIOStrategyInterface, AHIOProviderAssignmentBuilder):
 
+    def _build_cita_fields(self) -> dict:
+        """Devuelve los campos cita/fechaHoraCita para el payload de AHIO cuando el caso es programado."""
+        if self.data.get("programmed") != 1:
+            return {}
+
+        programdate = self.data.get("programdate")
+        if not programdate:
+            return {}
+
+        fecha_hora = datetime.strptime(programdate[:19], "%Y-%m-%dT%H:%M:%S")
+        return {
+            "cita": True,
+            "fechaHoraCita": fecha_hora.strftime("%d/%m/%Y %H:%M:%S"),
+        }
+
     def __process_data(self):
         """It is the center of the class, here the changes to assign or remove a user from a case will be processed.
         @return response: Object Response of service AHIO.
@@ -32,7 +48,8 @@ class ProposeService(AHIOStrategyInterface, AHIOProviderAssignmentBuilder):
                 "destino": self.set_data_destination(),
                 "relacionServicios": self.get_relation_services(),
                 "clienteNA": self.get_data_client(),
-                "automovil": self.set_data_vehicle()
+                "automovil": self.set_data_vehicle(),
+                **self._build_cita_fields(),
             }
         }
 
