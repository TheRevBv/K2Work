+def try_assign_provider_from_ahio_response(case_id: int, response: dict) -> Optional[ProviderAssignmentResult]:
+    """Si la respuesta de AHIO ya trae sap_code, resuelve el proveedor en K2 y asigna.
+    Devuelve None si AHIO aún no tiene sap_code, para que el caller decida el siguiente paso."""
+    sap_code = (
+        response
+        .get(AhioDefinitions.RESPONSE, {})
+        .get(AhioDefinitions.CRANE, {})
+        .get(AhioDefinitions.SAP_CODE)
+    )
+    if not sap_code:
+        return None
+
+    provider, provider_site, coverage_id = get_provider_coverage_site_by_sap_code(sap_code=sap_code)
+    if not (provider and provider_site and coverage_id):
+        return ProviderAssignmentResult(
+            success=False,
+            message=f"No se encontró un proveedor en K2 para caso {case_id}"
+        )
+
+    return assign_provider(
+        case_id=case_id,
+        ahio_response=response,
+        provider=provider,
+        provider_site=provider_site,
+        coverage_id=coverage_id
+    )
