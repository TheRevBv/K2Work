--- /dev/null
+++ b/apiserver/ix/tests/auto_relevo/test_aviso_servicio_autorizado.py
@@ -0,0 +1,45 @@
+"""Aviso al asegurado cuando su servicio pasa a «Servicio autorizado»."""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta import auto_relevo_boleta_service as svc
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_models import EstatusServicioEnum
+
+COMPLETA = EstatusServicioEnum.DOCUMENTACION_COMPLETA.value
+AUTORIZADO = EstatusServicioEnum.SERVICIO_AUTORIZADO.value
+NO_AUTORIZADO = EstatusServicioEnum.NO_AUTORIZADO.value
+
+
+def _autorizar(actual, nuevo, aprobado=True):
+    servicio = SimpleNamespace(id=665, estatus_servicio=actual, boleta_informativa=None)
+    session = MagicMock()
+    session.query.return_value.filter.return_value.first.return_value = servicio
+
+    def aplicar(_self, *_args):
+        servicio.estatus_servicio = nuevo
+
+    with patch.object(svc, "g", SimpleNamespace(s=lambda: session)), \
+            patch.object(svc.AutoRelevoService, "_aplicar_autorizacion_servicio", aplicar), \
+            patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_autorizado") as aviso:
+        svc.AutoRelevoService().registrar_autorizacion(665, {"aprobado": aprobado, "comentario": "x"})
+    return aviso
+
+
+def test_avisa_al_autorizar():
+    _autorizar(COMPLETA, AUTORIZADO).assert_called_once_with(665)
+
+
+@pytest.mark.parametrize("actual,nuevo,aprobado", [
+    (COMPLETA, NO_AUTORIZADO, False),
+    (AUTORIZADO, AUTORIZADO, True),
+])
+def test_no_avisa_sin_transicion_a_autorizado(actual, nuevo, aprobado):
+    _autorizar(actual, nuevo, aprobado).assert_not_called()
+
+
+def test_url_micrositio_por_ambiente(monkeypatch):
+    monkeypatch.setenv("GAE_APP_ID", "morfeo-test")
+    assert svc.AutoRelevoNotificationsService.url_micrositio() == \
+        "https://micrositio-autorelevo-web-dot-morfeo-test.ue.r.appspot.com/autorelevo/"
