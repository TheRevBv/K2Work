     with patch.object(svc, "g", SimpleNamespace(s=lambda: session)), \
             patch.object(svc.AutoRelevoService, "_aplicar_autorizacion_servicio", aplicar), \
+            patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_no_autorizado"), \
             patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_autorizado") as aviso:
         svc.AutoRelevoService().registrar_autorizacion(665, {"aprobado": aprobado, "comentario": "x"})
     return aviso
@@ -61,3 +62,13 @@ def test_avisa_al_autorizar_desde_el_admin():
             patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_autorizado") as aviso:
         svc.AutoRelevoService().update_ticket(665, {"boleta_informativa": {"evaluador_aprobo_servicio": True}})
     aviso.assert_called_once_with(665)
+
+
+def test_avisa_no_autorizado_con_motivo():
+    servicio = SimpleNamespace(id=665, estatus_servicio=NO_AUTORIZADO, razon_estatus="Póliza sin cobertura")
+    with patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_no_autorizado") as aviso, \
+            patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_autorizado") as autorizado:
+        svc.AutoRelevoService._avisar_si_autorizado(servicio, COMPLETA)
+        svc.AutoRelevoService._avisar_si_autorizado(servicio, NO_AUTORIZADO)
+    aviso.assert_called_once_with(665, "Póliza sin cobertura")
+    autorizado.assert_not_called()
