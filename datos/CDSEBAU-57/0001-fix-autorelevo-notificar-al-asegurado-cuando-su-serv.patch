From 0229a1e7209a91c83b69f47b67b13eae8beb06c4 Mon Sep 17 00:00:00 2001
From: JoshMorinDev <joshua.morinsalazar@chubb.com>
Date: Tue, 24 Nov 2026 11:47:57 -0600
Subject: [PATCH] fix(autorelevo): notificar al asegurado cuando su servicio no
 es autorizado

---
 .../auto_relevo_boleta_service.py             |   8 +-
 .../notifications_manager.py                  |  11 ++
 .../autorelevo_servicio_no_autorizado.html    | 111 ++++++++++++++++++
 .../test_aviso_servicio_autorizado.py         |  13 +-
 4 files changed, 140 insertions(+), 3 deletions(-)
 create mode 100644 apiserver/ix/boletas_informativas/auto_relevo/api/template/autorelevo_servicio_no_autorizado.html

diff --git a/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/auto_relevo_boleta_service.py b/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/auto_relevo_boleta_service.py
index 0c8ce727..86703d11 100644
--- a/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/auto_relevo_boleta_service.py
+++ b/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/auto_relevo_boleta_service.py
@@ -1261,9 +1261,13 @@ class AutoRelevoService:
 
     @staticmethod
     def _avisar_si_autorizado(servicio, estatus_previo):
-        autorizado = EstatusServicioEnum.SERVICIO_AUTORIZADO.value
-        if servicio.estatus_servicio == autorizado and estatus_previo != autorizado:
+        """Notifica al titular cuando el servicio entra a «Servicio autorizado» o «No autorizado»."""
+        if servicio.estatus_servicio == estatus_previo:
+            return
+        if servicio.estatus_servicio == EstatusServicioEnum.SERVICIO_AUTORIZADO.value:
             AutoRelevoNotificationsService.envio_mail_servicio_autorizado(servicio.id)
+        elif servicio.estatus_servicio == EstatusServicioEnum.NO_AUTORIZADO.value:
+            AutoRelevoNotificationsService.envio_mail_servicio_no_autorizado(servicio.id, servicio.razon_estatus)
 
     def _aplicar_autorizacion_servicio(self, ticket_id, servicio, aprobado, comentario, aprobado_previo):
         # Tickets que llegaron a "Vehiculo entregado" sin decisión del evaluador se autorizan tarde.
diff --git a/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/notifications_manager.py b/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/notifications_manager.py
index 9f8b62cd..4562deec 100644
--- a/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/notifications_manager.py
+++ b/apiserver/ix/boletas_informativas/auto_relevo/api/auto_relevo_boleta/notifications_manager.py
@@ -91,6 +91,17 @@ class AutoRelevoNotificationsService:
             url_micrositio=AutoRelevoNotificationsService.url_micrositio(),
         )
 
+    @staticmethod
+    def envio_mail_servicio_no_autorizado(servicio_id, motivo):
+        """Avisa al titular que su servicio no fue autorizado, con el motivo capturado por el operador."""
+        AutoRelevoNotificationsService._envio_aviso_titular(
+            servicio_id,
+            "autorelevo_servicio_no_autorizado.html",
+            "AUTO RELEVO - Servicio no autorizado",
+            url_micrositio=AutoRelevoNotificationsService.url_micrositio(),
+            motivo=motivo,
+        )
+
     @staticmethod
     def url_micrositio():
         """URL de entrada al micrositio del ambiente actual (misma base que el proxy de app.py)."""
diff --git a/apiserver/ix/boletas_informativas/auto_relevo/api/template/autorelevo_servicio_no_autorizado.html b/apiserver/ix/boletas_informativas/auto_relevo/api/template/autorelevo_servicio_no_autorizado.html
new file mode 100644
