diff --git a/apiserver/ix/tests/auto_relevo/test_aviso_servicio_autorizado.py b/apiserver/ix/tests/auto_relevo/test_aviso_servicio_autorizado.py
index 14752313..5cdd540a 100644
--- a/apiserver/ix/tests/auto_relevo/test_aviso_servicio_autorizado.py
+++ b/apiserver/ix/tests/auto_relevo/test_aviso_servicio_autorizado.py
@@ -43,3 +43,21 @@ def test_url_micrositio_por_ambiente(monkeypatch):
     monkeypatch.setenv("GAE_APP_ID", "morfeo-test")
     assert svc.AutoRelevoNotificationsService.url_micrositio() == \
         "https://micrositio-autorelevo-web-dot-morfeo-test.ue.r.appspot.com/autorelevo/"
+
+
+def test_avisa_al_autorizar_desde_el_admin():
+    servicio = SimpleNamespace(id=665, estatus_servicio=COMPLETA,
+                               boleta_informativa=SimpleNamespace(evaluador_aprobo_servicio=None))
+
+    def aplicar(_self, *_args):
+        servicio.estatus_servicio = AUTORIZADO
+
+    with patch.object(svc, "g", SimpleNamespace(s=MagicMock)), \
+            patch.object(svc, "AutoRelevoDataManager"), \
+            patch.object(svc.AutoRelevoService, "_fetch_servicio_with_relations", return_value=servicio), \
+            patch.object(svc.AutoRelevoService, "_update_related_entities"), \
+            patch.object(svc.AutoRelevoService, "_aplicar_autorizacion_servicio", aplicar), \
+            patch.object(svc.AutoRelevoService, "get_ticket_detail"), \
+            patch.object(svc.AutoRelevoNotificationsService, "envio_mail_servicio_autorizado") as aviso:
+        svc.AutoRelevoService().update_ticket(665, {"boleta_informativa": {"evaluador_aprobo_servicio": True}})
+    aviso.assert_called_once_with(665)
