@@ -0,0 +1,39 @@
+"""Un folio «No autorizado» queda cerrado: libera el evento y no admite más cambios."""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from ix.api.errors import ApiError
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta import auto_relevo_boleta_service as svc
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_models import EstatusServicioEnum
+
+COMPLETA = EstatusServicioEnum.DOCUMENTACION_COMPLETA.value
+NO_AUTORIZADO = EstatusServicioEnum.NO_AUTORIZADO.value
+CANCELADO = EstatusServicioEnum.CANCELADO.value
+
+
+def test_no_autorizar_libera_el_evento():
+    servicio = SimpleNamespace(id=7, estatus_servicio=COMPLETA, siniestro_id=99, boleta_informativa=None,
+                               razon_estatus=None)
+    manager = MagicMock()
+    manager.update_status_servicio_auto_relevo.side_effect = \
+        lambda _id, estatus: setattr(servicio, "estatus_servicio", estatus)
+    eventos = MagicMock()
+    g = SimpleNamespace(s=MagicMock, current_user=SimpleNamespace(id=1))
+    with patch.object(svc, "g", g), patch.object(svc, "AutoRelevoDataManager", return_value=manager), \
+            patch.object(svc, "AutoRelevoEventsManager", return_value=eventos):
+        svc.AutoRelevoService()._aplicar_autorizacion_servicio(7, servicio, False, "Sin cobertura", None)
+    assert servicio.estatus_servicio == NO_AUTORIZADO
+    eventos.release.assert_called_once_with(99)
+
+
+@pytest.mark.parametrize("estatus", [NO_AUTORIZADO, CANCELADO])
+def test_folio_cerrado_rechaza_cambios(estatus):
+    servicio = SimpleNamespace(id=7, estatus_servicio=estatus)
+    with patch.object(svc, "g", SimpleNamespace(s=MagicMock)), \
+            patch.object(svc.AutoRelevoService, "_fetch_servicio_with_relations", return_value=servicio), \
+            patch.object(svc.AutoRelevoService, "_update_related_entities") as actualizar:
+        with pytest.raises(ApiError):
+            svc.AutoRelevoService().update_ticket(7, {"boleta_informativa": {"evaluador_aprobo_servicio": True}})
+    actualizar.assert_not_called()
