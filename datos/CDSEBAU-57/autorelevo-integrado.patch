+++ b/apiserver/ix/tools/services/autorelevo_policy.py
@@ -35,7 +35,13 @@ class AutorelevoPolicyService(ChubbPolicy):
                     headers=self.get_headers(),
                     timeout=30,
                 )
-                result = response.json()
+                # HTML o 5xx del gateway es falla transitoria: RuntimeError reintenta; ValueError sería "póliza no válida".
+                if response.status_code >= 500:
+                    raise RuntimeError(f"Policy/Validate HTTP {response.status_code}")
+                try:
+                    result = response.json()
+                except ValueError as exc:
+                    raise RuntimeError(f"Policy/Validate respuesta no JSON (HTTP {response.status_code})") from exc
                 print(f"[validate_policy] HTTP={response.status_code} isSuccess={result.get('isSuccess')} responseData={str(result.get('responseData',''))[:120]}")
 
                 # isSuccess=True es suficiente para aprobar — responseData puede ser
