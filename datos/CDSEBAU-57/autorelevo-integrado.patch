new file mode 100644
index 00000000..344cb2e8
--- /dev/null
+++ b/apiserver/ix/tests/test_autorelevo_policy.py
@@ -0,0 +1,40 @@
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from ix.tools.services.autorelevo_policy import AutorelevoPolicyService
+
+
+def _respuesta(status, json_value=None, json_error=None):
+    r = MagicMock(status_code=status)
+    r.json.side_effect = json_error if json_error else (lambda: json_value)
+    return r
+
+
+@pytest.fixture
+def svc():
+    with patch.object(AutorelevoPolicyService, "get_headers", return_value={}), \
+         patch.object(AutorelevoPolicyService, "_validate_url", return_value="http://x/Policy/Validate"):
+        yield AutorelevoPolicyService()
+
+
+def test_html_del_gateway_reintenta_y_no_es_poliza_invalida(svc):
+    html = _respuesta(500, json_error=ValueError("Expecting value"))
+    ok = _respuesta(200, {"isSuccess": True})
+    with patch("ix.tools.services.autorelevo_policy.req_lib.post", side_effect=[html, ok]) as post:
+        assert svc.validate_policy("Q250027051", 1, "2016019796") == {"isSuccess": True}
+    assert post.call_count == 2
+
+
+def test_falla_transitoria_persistente_no_es_value_error(svc):
+    html = _respuesta(200, json_error=ValueError("Expecting value"))
+    with patch("ix.tools.services.autorelevo_policy.req_lib.post", return_value=html):
+        with pytest.raises(RuntimeError):
+            svc.validate_policy("Q250027051", 1, "2016019796")
+
+
+def test_poliza_rechazada_sigue_siendo_value_error(svc):
+    rechazo = _respuesta(400, {"isSuccess": False, "messages": [{"message": "Póliza no válida"}]})
+    with patch("ix.tools.services.autorelevo_policy.req_lib.post", return_value=rechazo):
+        with pytest.raises(ValueError, match="Póliza no válida"):
+            svc.validate_policy("Q250027051", 1, "2016019796")
diff --git a/apiserver/ix/tools/services/autorelevo_policy.py b/apiserver/ix/tools/services/autorelevo_policy.py
