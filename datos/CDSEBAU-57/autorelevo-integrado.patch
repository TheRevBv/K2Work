+"""Folio abierto por póliza: filtro `abierto`, validación de formato, bloqueo 409 y liberación del evento."""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+from sqlalchemy.orm import Query
+
+from ix.api import errors
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_models import (
+    EstatusEventoEnum, ServicioAutoRelevo)
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_service import (
+    AutoRelevoService, ERROR_OPEN_TICKET)
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_events_manager import (
+    AutoRelevoEventsManager)
+from ix.boletas_informativas.auto_relevo.api.utils.constants import ESTATUS_SIN_RECALCULO
+
+
+def _error_code(exc_info):
+    return exc_info.value.args[1] if len(exc_info.value.args) > 1 else exc_info.value.error_code
+
+
+def test_filtro_abierto_excluye_estatus_cerrados():
+    query = AutoRelevoService()._filter_open(Query([ServicioAutoRelevo]))
+    sql = str(query.statement.compile(compile_kwargs={"literal_binds": True}))
+    assert "NOT IN" in sql
+    for estatus in ("Finalizado", "Cancelado", "No autorizado"):
+        assert estatus in sql
+    assert "active_record" in sql
+    assert ESTATUS_SIN_RECALCULO == {"Finalizado", "Cancelado", "No autorizado"}
+
+
+@pytest.mark.parametrize("poliza", ["12345", "|12345", "CE|", ""])
+def test_poliza_sin_formato_valido_responde_400(poliza):
+    with pytest.raises(errors.ApiError) as exc:
+        AutoRelevoService()._filter_by_policy(Query([ServicioAutoRelevo]), poliza)
+    assert _error_code(exc) == 400
+
+
+def test_crear_ticket_con_folio_abierto_responde_409():
+    abierto = SimpleNamespace(id=648, estatus_servicio="Autorizado",
+                              boleta_informativa=SimpleNamespace(folio_servicio="AR-2026-00648"))
+    service = AutoRelevoService()
+    with patch.object(AutoRelevoService, "_find_open_ticket", return_value=abierto) as buscar, \
+            patch.object(AutoRelevoService, "search_sinister") as search:
+        with pytest.raises(errors.ApiError) as exc:
+            service.create_ticket({"poliza": "CE|50001692"}, "token")
+    buscar.assert_called_once_with("CE", "50001692")
+    search.assert_not_called()  # no se consulta a Chubb ni se crea nada
+    assert _error_code(exc) == 409
+    cuerpo = exc.value.args[0]
+    assert cuerpo["error"] == ERROR_OPEN_TICKET
+    assert cuerpo["data"][0] == {"ticket_id": 648, "folio_servicio": "AR-2026-00648",
+                                 "estatus_servicio": "Autorizado"}
+
+
+def test_crear_ticket_sin_folio_abierto_continua_el_flujo():
+    service = AutoRelevoService()
+    with patch.object(AutoRelevoService, "_find_open_ticket", return_value=None), \
+            patch.object(AutoRelevoService, "search_sinister", side_effect=RuntimeError("siguió")) as search:
+        with pytest.raises(RuntimeError, match="siguió"):
+            service.create_ticket({"poliza": "CE|50001692"}, "token")
+    search.assert_called_once()
+
+
+def _manager_con_evento(status, dias=5, usados=5):
+    event = SimpleNamespace(status_eventos=status, numero_eventos=dias, events_count_id=1, audit_updated_by=None)
+    count = SimpleNamespace(eventos_usados=usados, eventos_total=15, eventos_restantes=15 - usados, audit_updated_by=None)
+    session = MagicMock()
+    session.query.return_value.get.return_value = count
+    manager = AutoRelevoEventsManager(session)
+    return manager, event, count
+
+
+@pytest.mark.parametrize("estatus", ["Cancelado", "No autorizado"])
+def test_folio_cancelado_o_no_autorizado_libera_evento(estatus):
+    servicio = SimpleNamespace(estatus_servicio=estatus, siniestro_id=7)
+    with patch("ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_service."
+               "AutoRelevoEventsManager") as manager_cls:
+        AutoRelevoService()._sync_event_status(servicio)
+    manager_cls.return_value.release.assert_called_once_with(7)
+
+
+def test_release_reservado_devuelve_dias_y_cancela_evento():
+    manager, event, count = _manager_con_evento(EstatusEventoEnum.RESERVADO, dias=5, usados=5)
+    with patch.object(AutoRelevoEventsManager, "_active_event", return_value=event), \
+            patch("ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_events_manager.g",
+                  SimpleNamespace(current_user=SimpleNamespace(id=1))):
+        manager.release(7)
+    assert event.status_eventos == EstatusEventoEnum.CANCELADO
+    assert count.eventos_usados == 0
+    assert count.eventos_restantes == 15
+
+
+def test_release_en_curso_cierra_sin_devolver_dias():
+    manager, event, count = _manager_con_evento(EstatusEventoEnum.EN_CURSO, dias=5, usados=5)
+    with patch.object(AutoRelevoEventsManager, "_active_event", return_value=event), \
+            patch("ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_events_manager.g",
+                  SimpleNamespace(current_user=SimpleNamespace(id=1))):
+        manager.release(7)
+    assert event.status_eventos == EstatusEventoEnum.FINALIZADO
+    assert count.eventos_usados == 5
+
+
+def test_release_sin_evento_activo_no_hace_nada():
+    manager, _, _ = _manager_con_evento(EstatusEventoEnum.RESERVADO)
+    with patch.object(AutoRelevoEventsManager, "_active_event", return_value=None):
+        assert manager.release(7) is None
+
+
+# ── Validación de antigüedad del siniestro (48 h) y vigencia con siniestro ─────────────────────────────
+
+from datetime import date, datetime, timedelta  # noqa: E402
+
+
+def _fecha_chubb(dt):
+    return dt.strftime('%m/%d/%Y %I:%M:%S %p')
+
+
+AHORA = datetime(2026, 11, 9, 12, 0, 0)
+
+
+def test_siniestro_con_menos_de_48_horas_responde_422():
+    reportado = AHORA - timedelta(hours=47, minutes=59)
+    with pytest.raises(errors.ApiError) as exc:
+        AutoRelevoService()._validar_antiguedad_siniestro(_fecha_chubb(reportado), ahora=AHORA)
+    assert _error_code(exc) == 422
+    assert "48 horas" in exc.value.args[0]["detail"]
+
+
+@pytest.mark.parametrize("horas", [48, 49, 500])
+def test_siniestro_con_48_horas_o_mas_pasa(horas):
+    reportado = AHORA - timedelta(hours=horas)
+    AutoRelevoService()._validar_antiguedad_siniestro(_fecha_chubb(reportado), ahora=AHORA)
+
+
+@pytest.mark.parametrize("fecha", [None, "", "no es fecha", "2026-11-09"])
+def test_sin_fecha_de_reporte_utilizable_no_bloquea(fecha):
+    AutoRelevoService()._validar_antiguedad_siniestro(fecha, ahora=AHORA)
+
+
+def _validar_con_vigencia_terminada(permitir):
+    manager = AutoRelevoEventsManager(MagicMock())
+    count = SimpleNamespace(id=1, eventos_restantes=10)
+    manager.session.query.return_value.filter.return_value.first.return_value = None  # sin evento activo
+    ayer = date.today() - timedelta(days=1)
+    with patch.object(AutoRelevoEventsManager, "_find_count", return_value=count):
+        return manager.validate_and_get_count(
+            "CE", "50001692", "1", ayer - timedelta(days=365), ayer, 3, permitir_vigencia_vencida=permitir)
+
+
+def test_vigencia_terminada_se_rechaza_sin_siniestro():
+    with pytest.raises(errors.ApiError) as exc:
+        _validar_con_vigencia_terminada(permitir=False)
+    assert _error_code(exc) == 400
+    assert "vigencia de la póliza terminó" in exc.value.args[0]["detail"]
+
+
+def test_vigencia_terminada_se_permite_con_siniestro():
+    assert _validar_con_vigencia_terminada(permitir=True).eventos_restantes == 10
