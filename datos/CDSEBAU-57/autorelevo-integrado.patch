+    def release(self, autorelevo_sinister_id):
+        """Cierra el evento de un folio Cancelado o No autorizado y libera la póliza para otro folio.
+        Si solo estaba reservado, devuelve los días al conteo; si ya estaba en curso (vehículo entregado),
+        los días se consideran usados y el evento se cierra como finalizado."""
+        event = self._active_event(autorelevo_sinister_id)
+        if not event:
+            return None
+        if event.status_eventos == EstatusEventoEnum.RESERVADO:
+            count = self.session.query(AutorelevoEventsCount).get(event.events_count_id)
+            count.eventos_usados -= event.numero_eventos
+            self._recalculate(count)
+            event.status_eventos = EstatusEventoEnum.CANCELADO
+        else:
+            event.status_eventos = EstatusEventoEnum.FINALIZADO
+        event.audit_updated_by = g.current_user.id
+        return event
