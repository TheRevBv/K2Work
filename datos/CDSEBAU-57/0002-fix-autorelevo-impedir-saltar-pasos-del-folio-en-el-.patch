+"""El PUT del admin no acepta datos de un paso cuyo anterior no está completo."""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from ix.api.errors import ApiError
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta import auto_relevo_boleta_service as svc
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_models import EstatusServicioEnum as E
+
+AUTORIZACION = {"boleta_informativa": {"fecha_autorizacion_siniestro": "2026-11-24T10:00", "tiempo_autorizacion_valuacion": 1,
+                                       "fecha_asignacion_auto": "2026-11-24T10:00", "tiempo_asignacion": 1}}
+ASIGNACION = {"boleta_informativa": {"fecha_entrega_vehiculo": "2026-11-25T10:00", "total_dias_journey": 5},
+              "vehiculos_asignados": [{"id": 1, "modelo_vehiculo": "Aveo", "grupo_vehiculo_id": 2}]}
+SEGUIMIENTO = {"vehiculos_asignados": [{"id": 1, "total_dias_uso_vehiculo": 5, "restante_dias": 0}]}
+
+
+def _validar(estatus, payload, docs_aprobados=False, vehiculo=None):
+    vehiculo = vehiculo or SimpleNamespace(id=1, modelo_vehiculo=None, grupo_vehiculo_id=None,
+                                           total_dias_uso_vehiculo=None, restante_dias=None)
+    servicio = SimpleNamespace(id=7, estatus_servicio=estatus,
+                               boleta_informativa=SimpleNamespace(vehiculos_asignados=[vehiculo]))
+    manager = MagicMock()
+    manager.are_all_documents_approved.return_value = docs_aprobados
+    with patch.object(svc, "g", SimpleNamespace(s=MagicMock)), \
+            patch.object(svc, "AutoRelevoDataManager", return_value=manager):
+        svc.AutoRelevoService()._validate_orden_pasos(servicio, payload)
+
+
+@pytest.mark.parametrize("estatus,payload", [
+    (E.EN_REVISION.value, AUTORIZACION),
+    (E.DOCUMENTACION_INCOMPLETA.value, AUTORIZACION),
+    (E.DOCUMENTACION_COMPLETA.value, ASIGNACION),
+    (E.SERVICIO_AUTORIZADO.value, SEGUIMIENTO),
+])
+def test_rechaza_paso_fuera_de_orden(estatus, payload):
+    with pytest.raises(ApiError):
+        _validar(estatus, payload)
+
+
+@pytest.mark.parametrize("estatus,payload", [
+    (E.DOCUMENTACION_COMPLETA.value, AUTORIZACION),
+    (E.SERVICIO_AUTORIZADO.value, AUTORIZACION),
+    (E.SERVICIO_AUTORIZADO.value, ASIGNACION),
+    (E.VEHICULO_ENTREGADO.value, ASIGNACION),
+    (E.VEHICULO_ENTREGADO.value, SEGUIMIENTO),
+    (E.FINALIZADO.value, SEGUIMIENTO),
+])
+def test_acepta_paso_en_orden(estatus, payload):
+    _validar(estatus, payload)
+
+
+def test_folio_viejo_con_documentos_aprobados_puede_autorizarse():
+    _validar("Pendiente", AUTORIZACION, docs_aprobados=True)
+
+
+def test_reenvio_del_vehiculo_sin_cambios_no_bloquea():
+    vehiculo = SimpleNamespace(id=1, modelo_vehiculo="Aveo", grupo_vehiculo_id=2, total_dias_uso_vehiculo=None, restante_dias=None)
+    reenvio = {"razon_estatus": "Pérdida parcial",
+               "vehiculos_asignados": [{"id": 1, "modelo_vehiculo": "Aveo", "grupo_vehiculo_id": 2, "reembolso": False}]}
+    _validar(E.EN_REVISION.value, reenvio, vehiculo=vehiculo)
+
+
+def test_motivo_y_titular_no_dependen_del_estatus():
+    _validar(E.PENDIENTE.value, {"datos_titular": {"nombre_completo": "Ana"}, "razon_estatus": "x",
+                                 "vehiculos_asignados": [{"id": 1, "reembolso": False, "motivo_reembolso": None}]})
