+import { inject } from '@angular/core';
+import { CanActivateFn, Router } from '@angular/router';
+import { RelevoTicketFormModel } from 'src/app/app-models/api/relevo/relevo_ticket_form.model';
+import { RelevoStoreService } from 'src/app/app-store/services/relevo.store.service';
+
+/** Pasos del folio de autorelevo en el orden en que se capturan (= path de la ruta hija). */
+export const PASOS_RELEVO = ['owner-data', 'reason', 'documents', 'authorization', 'assignment', 'followup'] as const;
+export type PasoRelevo = typeof PASOS_RELEVO[number];
+
+const COMPLETO: Record<PasoRelevo, (t: RelevoTicketFormModel) => boolean> = {
+    'owner-data': (t) => {
+        const d = t?.DatosTitular;
+        const u = t?.UbicacionTitular;
+        return !!(d?.nombre_completo && d?.telefono_contacto && d?.correo_electronico && u?.estado && u?.municipio && u?.codigo_postal);
+    },
+    'reason': (t) => !!(t?.ServicioAutoRelevo?.razon_estatus || (t?.VehiculoAsignado?.reembolso && t?.VehiculoAsignado?.motivo_reembolso)),
+    'documents': (t) => {
+        const docs = t?.DocumentosValidacion ?? [];
+        return docs.length > 0 && docs.every((d) => d.estatus_validacion === 'Aprobado');
+    },
+    'authorization': (t) => {
+        const b = t?.BoletaInformativa;
+        return !!(b?.fecha_autorizacion_siniestro && b?.tiempo_autorizacion_valuacion && b?.fecha_asignacion_auto && b?.tiempo_asignacion)
+            && typeof b?.evaluador_aprobo_servicio === 'boolean';
+    },
+    'assignment': (t) => {
+        const b = t?.BoletaInformativa;
+        return !!(b?.fecha_entrega_vehiculo && b?.tiempo_asignacion !== null && b?.total_dias_journey && t?.VehiculoAsignado?.modelo_vehiculo);
+    },
+    'followup': (t) => !!(t?.VehiculoAsignado?.total_dias_uso_vehiculo && t?.VehiculoAsignado?.restante_dias !== null),
+};
+
+export function pasoCompleto(ticket: RelevoTicketFormModel, paso: PasoRelevo): boolean {
+    return COMPLETO[paso](ticket);
+}
+
+/** Un paso se abre si todos los anteriores están completos; asignación y seguimiento exigen la autorización en «Sí». */
+export function pasoPermitido(ticket: RelevoTicketFormModel, paso: PasoRelevo): boolean {
+    const anteriores = PASOS_RELEVO.slice(0, PASOS_RELEVO.indexOf(paso));
+    if (!anteriores.every((p) => pasoCompleto(ticket, p))) return false;
+    if (paso === 'assignment' || paso === 'followup') return ticket?.BoletaInformativa?.evaluador_aprobo_servicio === true;
+    return true;
+}
+
+/** Paso más avanzado al que el folio puede entrar hoy. */
+export function pasoActual(ticket: RelevoTicketFormModel): PasoRelevo {
+    return [...PASOS_RELEVO].reverse().find((p) => pasoPermitido(ticket, p)) ?? 'owner-data';
+}
+
+export const pasoRelevoGuard: CanActivateFn = (route) => {
+    const router = inject(Router);
+    const ticket = inject(RelevoStoreService).getRelevoCreatedTicket();
+    if (!ticket) return router.parseUrl('/admin/relevo-car');
+    const paso = route.routeConfig?.path as PasoRelevo;
+    return pasoPermitido(ticket, paso) || router.parseUrl(`/admin/relevo-car/steps/${pasoActual(ticket)}`);
+};
