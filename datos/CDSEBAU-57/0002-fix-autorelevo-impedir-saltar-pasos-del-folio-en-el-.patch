+    def _validate_orden_pasos(self, servicio, payload):
+        """Rechaza datos de un paso cuyo anterior no está completo (según el estatus del folio).
+
+        Solo cuentan los valores que cambian: el admin reenvía el vehículo completo en cada guardado.
+        """
+        for paso in self._pasos_con_cambios(servicio, payload):
+            if servicio.estatus_servicio in ESTATUS_POR_PASO[paso]:
+                continue
+            # Folios previos al recálculo de estatus: basta con la documentación aprobada.
+            if paso == "autorización" and AutoRelevoDataManager(g.s()).are_all_documents_approved(servicio.id):
+                continue
+            self._handle_error(
+                f"No se puede capturar {paso} con el folio en '{servicio.estatus_servicio}'; completa el paso anterior",
+                ERROR_INVALID, 400, rollback=False
+            )
+
+    @staticmethod
+    def _pasos_con_cambios(servicio, payload):
+        boleta_data = payload.get("boleta_informativa") or {}
+        pasos = set()
+        for paso, campos in CAMPOS_BOLETA_POR_PASO.items():
+            if any(boleta_data.get(c) is not None for c in campos):
+                pasos.add(paso)
+        vehiculos_data = payload.get("vehiculos_asignados") or []
+        vehiculos = list(servicio.boleta_informativa.vehiculos_asignados) if vehiculos_data and servicio.boleta_informativa else []
+        for vehiculo_data in vehiculos_data:
+            actual = next((v for v in vehiculos if v.id == vehiculo_data.get("id")), None)
+            for paso, campos in CAMPOS_VEHICULO_POR_PASO.items():
+                if any(vehiculo_data.get(c) is not None and vehiculo_data.get(c) != getattr(actual, c, None) for c in campos):
+                    pasos.add(paso)
+        return pasos
+
     @staticmethod
     def _avisar_si_autorizado(servicio, estatus_previo):
         """Notifica al titular cuando el servicio entra a «Servicio autorizado» o «No autorizado»."""
