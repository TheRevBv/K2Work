@@ -0,0 +1,40 @@
+import { pasoActual, pasoPermitido } from './relevo-steps';
+
+const completo = (): any => ({
+    DatosTitular: { nombre_completo: 'Ana', telefono_contacto: '5555555555', correo_electronico: 'a@b.com' },
+    UbicacionTitular: { estado: 9, municipio: 'X', codigo_postal: '01000' },
+    ServicioAutoRelevo: { razon_estatus: 'Pérdida parcial' },
+    DocumentosValidacion: [{ estatus_validacion: 'Aprobado' }],
+    BoletaInformativa: {
+        fecha_autorizacion_siniestro: '2026-11-24', tiempo_autorizacion_valuacion: 1, fecha_asignacion_auto: '2026-11-24',
+        tiempo_asignacion: 1, evaluador_aprobo_servicio: true, fecha_entrega_vehiculo: '2026-11-25', total_dias_journey: 5,
+    },
+    VehiculoAsignado: { modelo_vehiculo: 'Aveo', total_dias_uso_vehiculo: 5, restante_dias: 0 },
+});
+
+describe('relevo-steps', () => {
+    it('folio nuevo solo abre titular', () => {
+        expect(pasoPermitido({} as any, 'owner-data')).toBeTrue();
+        expect(pasoPermitido({} as any, 'reason')).toBeFalse();
+        expect(pasoActual({} as any)).toBe('owner-data');
+    });
+
+    it('no salta documentos pendientes', () => {
+        const t = completo();
+        t.DocumentosValidacion = [{ estatus_validacion: 'Rechazado' }];
+        expect(pasoPermitido(t, 'authorization')).toBeFalse();
+        expect(pasoActual(t)).toBe('documents');
+    });
+
+    it('autorización en No bloquea asignación y seguimiento', () => {
+        const t = completo();
+        t.BoletaInformativa.evaluador_aprobo_servicio = false;
+        expect(pasoPermitido(t, 'assignment')).toBeFalse();
+        expect(pasoPermitido(t, 'followup')).toBeFalse();
+        expect(pasoActual(t)).toBe('authorization');
+    });
+
+    it('folio completo llega a seguimiento', () => {
+        expect(pasoActual(completo())).toBe('followup');
+    });
+});
