meta {
  name: Foto 1 - OK
  type: http
  seq: 11
}

put {
  url: {{baseUrl}}/v2/ajuste-movil/cases/{{caseId}}/photo-batches/{{batchId}}/photos/1
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  expected_count: 2
  file: @file(archivos/foto-1.jpg)
}

assert {
  res.status: eq 201
}
