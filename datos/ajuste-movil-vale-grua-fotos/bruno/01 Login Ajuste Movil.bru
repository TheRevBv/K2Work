meta {
  name: Login Ajuste Movil
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/token
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}",
    "password": "{{password}}"
  }
}

script:post-response {
  bru.setEnvVar("token", res.body.token);
}

assert {
  res.status: eq 200
}
