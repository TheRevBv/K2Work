meta {
  name: Foto - consecutivo fuera de rango
  type: http
  seq: 15
}

put {
  url: {{baseUrl}}/v2/ajuste-movil/cases/{{caseId}}/photo-batches/{{batchId}}/photos/3
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  expected_count: 2
  file: @file(archivos/foto-2.png)
}

assert {
  res.status: eq 400
}
