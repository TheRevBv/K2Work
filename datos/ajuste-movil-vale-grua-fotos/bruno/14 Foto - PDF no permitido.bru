meta {
  name: Foto - PDF no permitido
  type: http
  seq: 14
}

put {
  url: {{baseUrl}}/v2/ajuste-movil/cases/{{caseId}}/photo-batches/{{batchId}}/photos/2
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  expected_count: 2
  file: @file(archivos/vale.pdf)
}

assert {
  res.status: eq 400
}
