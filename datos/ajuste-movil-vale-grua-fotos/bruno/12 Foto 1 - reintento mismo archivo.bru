meta {
  name: Foto 1 - reintento mismo archivo
  type: http
  seq: 12
}

put {
  url: {{baseUrl}}/v2/ajuste-movil/cases/{{caseId}}/photo-batches/{{batchId}}/photos/1
  body: multipartForm
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:multipart-form {
  expected_count: 2
  file: @file(archivos/foto-1.jpg)
}

assert {
  res.status: eq 200
}
