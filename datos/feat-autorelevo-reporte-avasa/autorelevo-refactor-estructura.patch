@@ -0,0 +1,64 @@
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+from ix.apps.importador.definitions import MAX_ORDEN_NUMERO, PREFIJOS_FORMULA
+from ix.apps.importador.mensajes import MSG_ENTERO, MSG_FECHA, MSG_FORMULA, MSG_NUMERO, MSG_NUMERO_RANGO
+from ix.apps.importador.schemas import TipoColumna
+from ix.apps.importador.utils import redondear
+
+
+def _texto(valor):
+    texto = str(valor).strip()
+    if str(valor).startswith(PREFIJOS_FORMULA) or texto.startswith(PREFIJOS_FORMULA):
+        raise ValueError(MSG_FORMULA)
+    return texto
+
+
+def _numero(valor) -> Decimal:
+    try:
+        numero = Decimal(str(valor).replace(",", "").strip())
+    except InvalidOperation:
+        raise ValueError(MSG_NUMERO)
+    if not numero.is_finite():
+        raise ValueError(MSG_NUMERO)
+    if numero.adjusted() > MAX_ORDEN_NUMERO:
+        raise ValueError(MSG_NUMERO_RANGO)
+    return numero
+
+
+def _decimal(valor):
+    try:
+        return redondear(_numero(valor))
+    except InvalidOperation:
+        raise ValueError(MSG_NUMERO)
+
+
+def _entero(valor):
+    numero = _numero(valor)
+    if numero != numero.to_integral_value():
+        raise ValueError(MSG_ENTERO)
+    return int(numero)
+
+
+def _fecha(valor):
+    if isinstance(valor, datetime):
+        return valor.date()
+    if isinstance(valor, date):
+        return valor
+    texto = str(valor).strip()
+    if len(texto) > 10 and texto[10] not in " T":
+        raise ValueError(MSG_FECHA)
+    try:
+        if len(texto) > 10:
+            return datetime.fromisoformat(texto).date()
+        return date.fromisoformat(texto)
+    except ValueError:
+        raise ValueError(MSG_FECHA)
+
+
+CONVERSORES = {
+    TipoColumna.TEXTO: _texto,
+    TipoColumna.DECIMAL: _decimal,
+    TipoColumna.ENTERO: _entero,
+    TipoColumna.FECHA: _fecha,
+}
