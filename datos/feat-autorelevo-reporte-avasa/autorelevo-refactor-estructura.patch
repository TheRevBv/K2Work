@@ -0,0 +1,29 @@
+from werkzeug.exceptions import RequestEntityTooLarge
+
+
+class EntradaLimitada:
+    """Envuelve wsgi.input y falla al superar el límite cuando no hay Content-Length."""
+
+    def __init__(self, flujo, limite):
+        self._flujo = flujo
+        self._restante = limite
+
+    def _consumir(self, datos):
+        self._restante -= len(datos)
+        if self._restante < 0:
+            raise RequestEntityTooLarge()
+        return datos
+
+    def read(self, tamano=-1):
+        if tamano is None or tamano < 0:
+            tamano = self._restante + 1
+        return self._consumir(self._flujo.read(min(tamano, self._restante + 1)))
+
+    def readline(self, tamano=-1):
+        if tamano is None or tamano < 0:
+            tamano = self._restante + 1
+        return self._consumir(self._flujo.readline(min(tamano, self._restante + 1)))
+
+    def __iter__(self):
+        while linea := self.readline():
+            yield linea
