new file mode 100644
index 00000000..34eea4ae
--- /dev/null
+++ b/apiserver/ix/apps/importador/utils.py
@@ -0,0 +1,18 @@
+from decimal import Decimal
+
+from ix.apps.importador.definitions import CENTAVOS
+
+
+def es_vacio(valor) -> bool:
+    return valor is None or str(valor).strip() == ""
+
+
+def celda(valores: list, indice: int | None):
+    """Valor de la celda o None si el índice no existe en la fila."""
+    if indice is None or indice >= len(valores):
+        return None
+    return valores[indice]
+
+
+def redondear(valor) -> Decimal:
+    return Decimal(valor).quantize(CENTAVOS)
