diff --git a/apiserver/ix/apps/importador/totales.py b/apiserver/ix/apps/importador/totales.py
new file mode 100644
index 00000000..82976453
--- /dev/null
+++ b/apiserver/ix/apps/importador/totales.py
@@ -0,0 +1,50 @@
+from decimal import Decimal
+
+from ix.apps.importador.conversores import CONVERSORES
+from ix.apps.importador.errors import ImportacionError, RowError
+from ix.apps.importador.mensajes import MSG_OBLIGATORIO, MSG_TOTALES_NO_CUADRAN
+from ix.apps.importador.utils import celda, es_vacio, redondear
+
+
+def _columna(layout, header):
+    return next(c for c in layout.columns if c.header == header)
+
+
+def es_fila_total(layout, indices, valores):
+    fila_total = layout.fila_total
+    if fila_total is None:
+        return False
+    valor = celda(valores, indices.get(_columna(layout, fila_total.header).field))
+    if valor is None:
+        return False
+    return str(valor).strip().casefold() == fila_total.marca.strip().casefold()
+
+
+def leer_totales(layout, indices, numero, valores):
+    """Convierte las celdas de la fila de totales; devuelve totales por campo y errores."""
+    totales, errores = {}, []
+    for columna in layout.columns:
+        if columna.field not in layout.fila_total.campos or columna.field not in indices:
+            continue
+        crudo = celda(valores, indices[columna.field])
+        try:
+            if es_vacio(crudo):
+                raise ValueError(MSG_OBLIGATORIO)
+            totales[columna.field] = redondear(CONVERSORES[columna.kind](crudo))
+        except ValueError as e:
+            errores.append(RowError(numero, columna.header, crudo, str(e)))
+    return totales, errores
+
+
+def verificar_totales(layout, registros, totales):
+    diferencias = []
+    for columna in layout.columns:
+        if columna.field not in totales:
+            continue
+        suma = redondear(sum((Decimal(r[columna.field]) for r in registros if r[columna.field] is not None),
+                             Decimal(0)))
+        if suma != totales[columna.field]:
+            diferencias.append({"columna": columna.header, "esperado": str(totales[columna.field]),
+                                "calculado": str(suma)})
+    if diferencias:
+        raise ImportacionError(MSG_TOTALES_NO_CUADRAN, errores=diferencias)
