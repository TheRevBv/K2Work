+++ b/apiserver/ix/apps/importador/layouts/__init__.py
@@ -0,0 +1,51 @@
+from ix.apps.importador.conversores import CONVERSORES
+from ix.apps.importador.layouts.avasa import AVASA_CONTRATOS
+from ix.apps.importador.schemas import TIPOS_NUMERICOS, ImportLayout
+
+LLAVE_RESERVADA = "layouts"
+
+
+def _validar_fila_total(layout: ImportLayout):
+    fila_total = layout.fila_total
+    if fila_total is None:
+        return
+    if fila_total.header not in {c.header for c in layout.columns}:
+        raise ValueError(
+            f"Layout '{layout.key}': fila_total.header '{fila_total.header}' no es una columna"
+        )
+    numericos = {c.field for c in layout.columns if c.kind in TIPOS_NUMERICOS}
+    for campo in fila_total.campos:
+        if campo not in numericos:
+            raise ValueError(
+                f"Layout '{layout.key}': fila_total.campos '{campo}' debe ser una columna "
+                f"decimal o int"
+            )
+
+
+def _registrar(*layouts: ImportLayout) -> dict:
+    registro = {}
+    for layout in layouts:
+        if layout.key == LLAVE_RESERVADA:
+            raise ValueError(f"La llave de layout '{LLAVE_RESERVADA}' está reservada")
+        for columna in layout.columns:
+            if columna.kind not in CONVERSORES:
+                raise ValueError(
+                    f"Layout '{layout.key}': tipo '{columna.kind}' de la columna "
+                    f"'{columna.field}' no existe en CONVERSORES"
+                )
+        llaves_obligatorias = {c.field for c in layout.columns if c.required}
+        if layout.upsert_key not in llaves_obligatorias:
+            raise ValueError(
+                f"Layout '{layout.key}': upsert_key '{layout.upsert_key}' debe ser una "
+                f"columna obligatoria"
+            )
+        _validar_fila_total(layout)
+        registro[layout.key] = layout
+    return registro
+
+
+LAYOUTS = _registrar(AVASA_CONTRATOS)
+
+
+def obtener_layout(key: str):
+    return LAYOUTS.get(key)
