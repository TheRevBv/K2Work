@@ -0,0 +1,86 @@
+import { HttpErrorResponse } from '@angular/common/http';
+import { TestBed } from '@angular/core/testing';
+import { Router } from '@angular/router';
+import { of, throwError } from 'rxjs';
+import { RelevoService } from 'src/app/app-business-services/relevo.service';
+import { MessagesService } from 'src/app/app-services';
+import { RelevoStoreService } from 'src/app/app-store/services/relevo.store.service';
+import { MeService } from 'src/app/services/me.service';
+import { ListComponent } from './list.component';
+
+describe('ListComponent importAvasaReport', () => {
+    let relevoService: jasmine.SpyObj<RelevoService>;
+    let messages: jasmine.SpyObj<MessagesService>;
+
+    function create(roles: string[] = ['admin']): ListComponent {
+        TestBed.configureTestingModule({
+            providers: [
+                { provide: RelevoService, useValue: relevoService },
+                { provide: MessagesService, useValue: messages },
+                { provide: MeService, useValue: { user: { id: 1, roles } } },
+                { provide: RelevoStoreService, useValue: {} },
+                { provide: Router, useValue: {} },
+            ],
+        });
+        return TestBed.runInInjectionContext(() => new ListComponent());
+    }
+
+    function failWith(status: number, error: any) {
+        relevoService.importAvasaReport.and.returnValue(throwError(() => new HttpErrorResponse({ status, error })));
+    }
+
+    const file = new File(['x'], 'avasa.xlsx');
+
+    beforeEach(() => {
+        relevoService = jasmine.createSpyObj('RelevoService', ['importAvasaReport']);
+        messages = jasmine.createSpyObj('MessagesService', [
+            'firePreloader', 'hidePreloader', 'fireSuccessMessage', 'fireErrorMessage',
+        ]);
+    });
+
+    it('muestra el botón solo a admin o supervisor', () => {
+        expect(create(['supervisor']).canImportAvasa).toBeTrue();
+        TestBed.resetTestingModule();
+        expect(create(['operator']).canImportAvasa).toBeFalse();
+    });
+
+    it('muestra el resumen cuando la carga es exitosa', () => {
+        relevoService.importAvasaReport.and.returnValue(of({ total: 3, insertados: 1, actualizados: 2 }));
+        const component = create();
+
+        component.importAvasaReport(file);
+
+        expect(messages.fireSuccessMessage).toHaveBeenCalledWith('3 contratos · 1 nuevos · 2 actualizados', 3);
+        expect(component.importError()).toBeNull();
+    });
+
+    it('abre el diálogo con los errores por fila', () => {
+        const data = [{ fila: 2, columna: 'Días Renta', valor: 'abc', mensaje: 'No es número' }];
+        failWith(400, { error: { detail: 'El archivo tiene errores', data, total_errores: 7 } });
+        const component = create();
+
+        component.importAvasaReport(file);
+
+        expect(component.importError()).toEqual({ detail: 'El archivo tiene errores', data, total_errores: 7 });
+        expect(messages.hidePreloader).toHaveBeenCalled();
+        expect(messages.fireErrorMessage).not.toHaveBeenCalled();
+    });
+
+    it('muestra el detail cuando no hay errores por fila', () => {
+        failWith(413, { error: { detail: 'El archivo excede el tamaño', data: [] } });
+        const component = create();
+
+        component.importAvasaReport(file);
+
+        expect(messages.fireErrorMessage).toHaveBeenCalledWith('Error al cargar el reporte', 'El archivo excede el tamaño');
+        expect(component.importError()).toBeNull();
+    });
+
+    it('muestra el mensaje en texto del 403', () => {
+        failWith(403, { error: 'Forbidden' });
+
+        create().importAvasaReport(file);
+
+        expect(messages.fireErrorMessage).toHaveBeenCalledWith('Error al cargar el reporte', 'Forbidden');
+    });
+});
