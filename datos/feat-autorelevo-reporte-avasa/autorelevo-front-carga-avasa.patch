+    public importAvasaReport(file: File): Observable<RelevoImportResultModel> {
+        const formData = new FormData();
+        formData.append('file', file);
+
+        return this.restService.execPostFormData('importador/avasa_contratos', formData).pipe(
+            map((response: any) => response!.data as RelevoImportResultModel)
+        );
+    }
