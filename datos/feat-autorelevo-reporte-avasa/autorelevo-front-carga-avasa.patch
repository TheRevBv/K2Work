@@ -148,6 +162,33 @@ export class ListComponent implements OnInit, OnDestroy {
         this.router.navigate(['/admin/relevo-car/reports']);
     }
 
+    importAvasaReport(file: File) {
+        this.messageService.firePreloader();
+        this.relevoService.importAvasaReport(file).subscribe({
+            next: ({ total, insertados, actualizados }) => this.messageService.fireSuccessMessage(
+                `${total} contratos · ${insertados} nuevos · ${actualizados} actualizados`, 3
+            ),
+            error: (err: HttpErrorResponse) => this.showImportError(err.error?.error),
+        });
+    }
+
+    /** El backend responde `{error: {detail, data, total_errores}}` o `{error: "mensaje"}` (403). */
+    private showImportError(error: any) {
+        if (error?.data?.length) {
+            this.messageService.hidePreloader();
+            this.importError.set({
+                detail: error.detail,
+                data: error.data,
+                total_errores: error.total_errores ?? error.data.length,
+            });
+            return;
+        }
+        this.messageService.fireErrorMessage(
+            'Error al cargar el reporte',
+            error?.detail ?? (typeof error === 'string' ? error : 'Intenta de nuevo más tarde')
+        );
+    }
+
     unmaskOwnerData() {
         this.showOwnerData = !this.showOwnerData
         if(this.showOwnerData) {
