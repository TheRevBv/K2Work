     roles: tuple
     max_bytes: int
     max_rows: int
+
+
+AVASA_CONTRATOS = ImportLayout(
+    key="avasa_contratos",
+    model=AutorelevoContratoRenta,
+    upsert_key="contract_number",
+    columns=(
+        ImportColumn("Contract Number", "contract_number", "text", required=True),
+        ImportColumn("Numero de Reserva", "numero_reserva", "text"),
+        ImportColumn("Número de Siniestro o Folio", "siniestro_folio", "text"),
+        ImportColumn("Días Renta", "dias_renta", "decimal", required=True),
+        ImportColumn("Total del contrato", "total_contrato", "decimal", required=True),
+        ImportColumn("Voucher Total", "voucher_total", "decimal", required=True),
+    ),
+    roles=(config.ADMIN, config.SUPERVISOR),
+    max_bytes=5 * 1024 * 1024,
+    max_rows=20_000,
+)
+
+
+def _registrar(*layouts: ImportLayout) -> dict:
+    registro = {}
+    for layout in layouts:
+        for columna in layout.columns:
+            if columna.kind not in CONVERSORES:
+                raise ValueError(
+                    f"Layout '{layout.key}': tipo '{columna.kind}' de la columna "
+                    f"'{columna.field}' no existe en CONVERSORES"
+                )
+        llaves_obligatorias = {c.field for c in layout.columns if c.required}
+        if layout.upsert_key not in llaves_obligatorias:
+            raise ValueError(
+                f"Layout '{layout.key}': upsert_key '{layout.upsert_key}' debe ser una "
+                f"columna obligatoria"
+            )
+        registro[layout.key] = layout
+    return registro
+
+
+LAYOUTS = _registrar(AVASA_CONTRATOS)
+
+
+def obtener_layout(key: str):
+    return LAYOUTS.get(key)
