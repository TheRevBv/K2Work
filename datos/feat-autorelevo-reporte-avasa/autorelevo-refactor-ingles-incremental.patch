diff --git a/apiserver/ix/apps/importador/converters.py b/apiserver/ix/apps/importador/converters.py
new file mode 100644
index 00000000..0252704c
--- /dev/null
+++ b/apiserver/ix/apps/importador/converters.py
@@ -0,0 +1,64 @@
+from datetime import date, datetime
+from decimal import Decimal, InvalidOperation
+
+from ix.apps.importador.definitions import FORMULA_PREFIXES, MAX_NUMBER_MAGNITUDE
+from ix.apps.importador.messages import MSG_DATE, MSG_FORMULA, MSG_INTEGER, MSG_NUMBER, MSG_NUMBER_RANGE
+from ix.apps.importador.schemas import ColumnType
+from ix.apps.importador.utils import round_cents
+
+
+def _to_text(value):
+    text = str(value).strip()
+    if str(value).startswith(FORMULA_PREFIXES) or text.startswith(FORMULA_PREFIXES):
+        raise ValueError(MSG_FORMULA)
+    return text
+
+
+def _to_number(value) -> Decimal:
+    try:
+        number = Decimal(str(value).replace(",", "").strip())
+    except InvalidOperation:
+        raise ValueError(MSG_NUMBER)
+    if not number.is_finite():
+        raise ValueError(MSG_NUMBER)
+    if number.adjusted() > MAX_NUMBER_MAGNITUDE:
+        raise ValueError(MSG_NUMBER_RANGE)
+    return number
+
+
+def _to_decimal(value):
+    try:
+        return round_cents(_to_number(value))
+    except InvalidOperation:
+        raise ValueError(MSG_NUMBER)
+
+
+def _to_integer(value):
+    number = _to_number(value)
+    if number != number.to_integral_value():
+        raise ValueError(MSG_INTEGER)
+    return int(number)
+
+
+def _to_date(value):
+    if isinstance(value, datetime):
+        return value.date()
+    if isinstance(value, date):
+        return value
+    text = str(value).strip()
+    if len(text) > 10 and text[10] not in " T":
+        raise ValueError(MSG_DATE)
+    try:
+        if len(text) > 10:
+            return datetime.fromisoformat(text).date()
+        return date.fromisoformat(text)
+    except ValueError:
+        raise ValueError(MSG_DATE)
+
+
+CONVERTERS = {
+    ColumnType.TEXT: _to_text,
+    ColumnType.DECIMAL: _to_decimal,
+    ColumnType.INTEGER: _to_integer,
+    ColumnType.DATE: _to_date,
+}
