@@ -0,0 +1,50 @@
+from decimal import Decimal
+
+from ix.apps.importador.converters import CONVERTERS
+from ix.apps.importador.errors import ImportFileError, RowError
+from ix.apps.importador.messages import MSG_REQUIRED, MSG_TOTALS_MISMATCH
+from ix.apps.importador.utils import cell_value, is_blank, round_cents
+
+
+def _column(layout, header):
+    return next(c for c in layout.columns if c.header == header)
+
+
+def is_total_row(layout, indexes, values):
+    total_row = layout.total_row
+    if total_row is None:
+        return False
+    value = cell_value(values, indexes.get(_column(layout, total_row.header).field))
+    if value is None:
+        return False
+    return str(value).strip().casefold() == total_row.marker.strip().casefold()
+
+
+def read_totals(layout, indexes, row_number, values):
+    """Convierte las celdas de la fila de totales; devuelve totales por campo y errores."""
+    totals, errors = {}, []
+    for column in layout.columns:
+        if column.field not in layout.total_row.fields or column.field not in indexes:
+            continue
+        raw = cell_value(values, indexes[column.field])
+        try:
+            if is_blank(raw):
+                raise ValueError(MSG_REQUIRED)
+            totals[column.field] = round_cents(CONVERTERS[column.kind](raw))
+        except ValueError as e:
+            errors.append(RowError(row_number, column.header, raw, str(e)))
+    return totals, errors
+
+
+def check_totals(layout, records, totals):
+    differences = []
+    for column in layout.columns:
+        if column.field not in totals:
+            continue
+        total = round_cents(sum((Decimal(r[column.field]) for r in records if r[column.field] is not None),
+                                Decimal(0)))
+        if total != totals[column.field]:
+            differences.append({"columna": column.header, "esperado": str(totals[column.field]),
+                                "calculado": str(total)})
+    if differences:
+        raise ImportFileError(MSG_TOTALS_MISMATCH, errors=differences)
