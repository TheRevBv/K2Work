+    def envio_mail_documentacion_aprobada(servicio_id):
+        """Avisa al titular que su documentación fue aprobada; un fallo de envío solo se registra."""
+        try:
+            data = AutoRelevoNotificationsService.get_servicio_data(servicio_id)
+            if not data["correo_electronico"]:
+                logging.warning("[autorelevo] Servicio %s sin correo para aviso de documentación aprobada", servicio_id)
+                return
+            template_path = os.path.join(os.path.dirname(__file__), "../template/autorelevo_documentacion_aprobada.html")
+            with open(template_path, "r", encoding="utf-8") as file:
+                email_template = file.read()
+            body = render_template_string(
+                email_template,
+                nombre_cliente=data["nombre_completo"] or "",
+                numero_siniestro=data["numero_siniestro"],
+                poliza=data["poliza"],
+            )
+            send_email(
+                recipients=data["correo_electronico"],
+                subject="AUTO RELEVO - Documentación aprobada",
+                body=body,
+            )
+        except Exception:
+            logging.exception("[autorelevo] Error enviando aviso de documentación aprobada servicio_id=%s", servicio_id)
