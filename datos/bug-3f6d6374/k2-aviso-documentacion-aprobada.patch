+"""Aviso al asegurado cuando su documentación pasa a «Documentación completa»."""
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta import auto_relevo_boleta_service as svc
+from ix.boletas_informativas.auto_relevo.api.auto_relevo_boleta.auto_relevo_boleta_models import EstatusServicioEnum
+
+EN_REVISION = EstatusServicioEnum.EN_REVISION.value
+COMPLETA = EstatusServicioEnum.DOCUMENTACION_COMPLETA.value
+
+
+def _recalcular(actual, todos_aprobados=True):
+    session = MagicMock()
+    session.query.return_value.get.return_value = SimpleNamespace(estatus_servicio=actual)
+    dm = MagicMock()
+    dm.has_rejected_documents.return_value = False
+    dm.are_all_documents_approved.return_value = todos_aprobados
+    dm.update_status_servicio_auto_relevo.return_value = SimpleNamespace()
+    with patch.object(svc, "g", SimpleNamespace(s=lambda: session)), \
+            patch.object(svc, "AutoRelevoDataManager", return_value=dm), \
+            patch.object(svc.AutoRelevoService, "_sync_event_status"), \
+            patch.object(svc.AutoRelevoNotificationsService, "envio_mail_documentacion_aprobada") as aviso:
+        svc.AutoRelevoService()._validate_status_flow(665)
+    return aviso
+
+
+def test_avisa_al_pasar_a_documentacion_completa():
+    _recalcular(EN_REVISION).assert_called_once_with(665)
+
+
+@pytest.mark.parametrize("actual,aprobados", [(COMPLETA, True), (EN_REVISION, False)])
+def test_no_avisa_sin_transicion_a_completa(actual, aprobados):
+    _recalcular(actual, aprobados).assert_not_called()
