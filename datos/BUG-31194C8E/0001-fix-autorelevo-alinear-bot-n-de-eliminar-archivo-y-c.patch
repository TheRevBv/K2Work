diff --git a/autorelevo/src/app/shared/components/file-upload-row/file-upload-row.component.ts b/autorelevo/src/app/shared/components/file-upload-row/file-upload-row.component.ts
index 4c7b452..d3b69af 100644
--- a/autorelevo/src/app/shared/components/file-upload-row/file-upload-row.component.ts
+++ b/autorelevo/src/app/shared/components/file-upload-row/file-upload-row.component.ts
@@ -1,14 +1,13 @@
 import { Component, Input, Output, EventEmitter, signal } from '@angular/core';
 import { NgClass } from '@angular/common';
 import { CbIconComponent } from '@chubb/ui-components/cb-icon';
-import { CbButtonDirective } from '@chubb/ui-components/cb-button';
 import { DocumentoRequerido } from '../../../core/models';
 import { FORMATOS_PERMITIDOS, TAMANO_MAXIMO_MB } from '../../constants';
 
 @Component({
   selector: 'app-file-upload-row',
   standalone: true,
-  imports: [NgClass, CbIconComponent, CbButtonDirective],
+  imports: [NgClass, CbIconComponent],
   template: `
     <div
       class="ar-file-row"
@@ -39,8 +38,8 @@ import { FORMATOS_PERMITIDOS, TAMANO_MAXIMO_MB } from '../../constants';
         <div class="ar-file-actions">
           <cb-icon iconKey="utility-success-check-fill" iconSize="small" iconColor="success-saturated"></cb-icon>
           <button
-            cbButton
-            [variant]="'ghost'"
