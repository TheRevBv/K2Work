+            class="ar-file-remove"
             aria-label="Eliminar archivo"
             (click)="onRemove($event)"
           ><cb-icon iconKey="utility-close" iconSize="small"></cb-icon></button>
@@ -91,6 +90,21 @@ import { FORMATOS_PERMITIDOS, TAMANO_MAXIMO_MB } from '../../constants';
     .ar-file-error { font-size: 12px; color: var(--c-error); margin-top: 2px; }
 
     .ar-file-actions { display: flex; align-items: center; gap: 8px; }
+    .ar-file-remove {
+      display: inline-flex;
+      align-items: center;
+      justify-content: center;
+      width: 28px;
+      height: 28px;
+      padding: 0;
+      background: none;
+      border: none;
+      border-radius: 50%;
+      color: var(--c-muted);
+      cursor: pointer;
+    }
+    .ar-file-remove:hover,
+    .ar-file-remove:focus-visible { color: var(--c-text); background: var(--c-secondary-light); }
 
     .ar-file-input {
       position: absolute;
