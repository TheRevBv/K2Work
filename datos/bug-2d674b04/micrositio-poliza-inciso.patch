diff --git a/autorelevo/src/app/core/utils/poliza.spec.ts b/autorelevo/src/app/core/utils/poliza.spec.ts
new file mode 100644
index 0000000..ba9552c
--- /dev/null
+++ b/autorelevo/src/app/core/utils/poliza.spec.ts
@@ -0,0 +1,12 @@
+import { polizaK2 } from './poliza';
+
+describe('polizaK2', () => {
+  it('arma PREFIJO|NUMERO sin inciso', () => {
+    expect(polizaK2('q2-500.27051')).toBe('Q2|50027051');
+    expect(polizaK2('Q250027051', '  ')).toBe('Q2|50027051');
+  });
+
+  it('agrega el inciso cuando se indica', () => {
+    expect(polizaK2('Q250027051', ' 1 ')).toBe('Q2|50027051|1');
+  });
+});
diff --git a/autorelevo/src/app/core/utils/poliza.ts b/autorelevo/src/app/core/utils/poliza.ts
index ed255bb..7aedad0 100644
--- a/autorelevo/src/app/core/utils/poliza.ts
+++ b/autorelevo/src/app/core/utils/poliza.ts
@@ -2,8 +2,13 @@
 export const normalizarPoliza = (valor?: string | null): string =>
   (valor ?? '').toUpperCase().replace(/[^A-Z0-9]/g, '');
 
-/** Póliza en el formato que espera K2: PREFIJO|NUMERO (los dos primeros caracteres son el prefijo). */
-export const polizaK2 = (valor?: string | null): string => {
+/**
+ * Póliza en el formato que espera K2: PREFIJO|NUMERO, o PREFIJO|NUMERO|INCISO si se indica el inciso
+ * (los dos primeros caracteres son el prefijo).
+ */
+export const polizaK2 = (valor?: string | null, inciso?: string | null): string => {
   const limpia = normalizarPoliza(valor);
-  return `${limpia.slice(0, 2)}|${limpia.slice(2)}`;
+  const base = `${limpia.slice(0, 2)}|${limpia.slice(2)}`;
+  const numInciso = (inciso ?? '').trim();
+  return numInciso ? `${base}|${numInciso}` : base;
 };
