diff --git a/apiserver/ix/whatsApp/utils/utils.py b/apiserver/ix/whatsApp/utils/utils.py
index 8a9b4913..b92bfeee 100644
--- a/apiserver/ix/whatsApp/utils/utils.py
+++ b/apiserver/ix/whatsApp/utils/utils.py
@@ -111,6 +111,20 @@ def _is_scheduled(data: dict) -> bool:
     return str(data.get("programado") or "").strip().upper() == "SI"
 
 
+def set_scheduled_ticket(data: dict) -> None:
+    """Marca el primer ticket como programado cuando WA envía programado=SI con fecha_programada."""
+    if not (_is_scheduled(data) and data.get("fecha_programada")):
+        return
+    fecha_programada = data["fecha_programada"]
+    fecha = datetime.strptime(fecha_programada[:19], "%Y-%m-%dT%H:%M:%S")
+    data["ticket"].update({
+        "programmed": 1,
+        "programdate": fecha_programada,
+        "program_type": m.AssistanceProgrammingType.COORDINATION,
+        "program_comment": f"Programado: {fecha:%d-%m-%Y %H:%M}",
+    })
+
