+class TestValidateServiceId:
+
+    @pytest.mark.parametrize("service_id, expected", [
+        (332, True),   # grúa tradicional: comportamiento previo, sin cambios
+        (391, True),   # colisión: lo que arregla este cambio
+        (333, False),  # cambio de llanta: sigue bloqueado
+    ])
+    def test_servicios_permitidos_para_cierre_automatico(self, service_id, expected):
+        with patch.object(module, "AhioRepository") as repo:
+            repo.return_value.get_instance.return_value = None
+            assert _process(service_id).validate_service_id() is expected
