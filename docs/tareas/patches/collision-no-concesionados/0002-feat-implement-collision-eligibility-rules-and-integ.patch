diff --git a/apiserver/ix/apps/ahio/collision_eligibility.py b/apiserver/ix/apps/ahio/collision_eligibility.py
new file mode 100644
index 00000000..507dac5a
--- /dev/null
+++ b/apiserver/ix/apps/ahio/collision_eligibility.py
@@ -0,0 +1,104 @@
+"""Reglas de elegibilidad Qonect para servicios de Colisión.
+
+Origen: PPTX "Cuestionarios Colisión" (láminas 1, 3 y 7) para vehículo y
+solicitante, y el PRD de Confluence "Digital Dispatch Platform (AHIO) -
+Fase 2 Colisión No concesionado para envío a Qonect" (actualizado
+2026-08-27) para destino y grúa en el lugar — ver §5.1 "Triggers
+confirmados" y RN-06/RN-07/RN-09.
+
+Principio fail-closed (PRD §30): un valor vacío, nulo o desconocido
+bloquea el despacho automático.
+"""
+
+import re
+
+ALLOWED_VEHICLE_TYPES = frozenset({"equipo ligero"})
+
+
+def _normalize(value) -> str:
+    return (value or "").strip().lower()
+
+
+def is_vehicle_type_allowed(car_type) -> bool:
+    """Lámina 3: solo Equipo Ligero puede ir a Qonect automático."""
+    return _normalize(car_type) in ALLOWED_VEHICLE_TYPES
+
+
+BLOCKED_DESTINATION_TYPES = frozenset({"ventura"})
+
+# `destination_type` es texto libre (no un catálogo cerrado), así que la
+# lista negra por sí sola dejaría pasar basura/inyecciones como "elegible"
+# (ya vimos payloads de AppScan en pruebas). Esto no es un catálogo de
+# valores válidos, solo una forma barata de distinguir texto de catálogo
+# normal de basura evidente, sin reconstruir la lista blanca que el PRD
+# pidió eliminar.
+_MAX_DESTINATION_LENGTH = 60
+_SUSPICIOUS_DESTINATION_RE = re.compile(r'["\'<>]|://')
+
+
+def is_destination_type_allowed(destination_type) -> bool:
+    """RN-09 (PRD Fase 2 §5.2): por ahora viajan TODOS los tipos de destino.
+
+    Reemplaza la lista blanca de Fase 1.5.3 (que solo permitía Agencia,
+    Taller y Centro de Valuación) — OPS/Redes confirmaron que Corralón,
+    Tránsito Municipal, Otro y Lugar del Siniestro también viajan. La
+    única excepción vigente es Ventura, excluida hasta que OPS/Redes
+    confirmen su tratamiento (ET-01: riesgo de cancelaciones por tiempos
+    de recepción altos). Fail-closed: vacío, desconocido, o texto que no
+    luce como catálogo normal (URLs, comillas, muy largo) bloquea.
+    """
+    normalized = _normalize(destination_type)
+    if not normalized or len(normalized) > _MAX_DESTINATION_LENGTH:
+        return False
+    if _SUSPICIOUS_DESTINATION_RE.search(normalized):
+        return False
+    return normalized not in BLOCKED_DESTINATION_TYPES
+
+
+ALLOWED_APPLICANT_TYPES = frozenset({"ajustador"})
+
+
+def is_applicant_type_allowed(applicant_type) -> bool:
+    """Lámina 1: solo Ajustador puede ir a Qonect automático.
+
+    No confundir con APPRAISER ('Valuador') de
+    ix/tools/definitions/catalog_equivalence.py, que se usa para otra
+    excepción (geocercas/Morfeo) y no debe unificarse con ésta.
+    """
+    return _normalize(applicant_type) in ALLOWED_APPLICANT_TYPES
+
+
+def is_crane_absent(case) -> bool:
+    """RN-07 (PRD Fase 2 §5.1): solo viaja si la grúa NO está ya en el lugar.
+
+    `AssistanceCase.caneinsite` (sic, columna real en BD) es Boolean con
+    default=True. Por eso el fail-closed aquí es "cualquier cosa que no
+    sea explícitamente False bloquea" — un caso sin este dato capturado
+    hereda el default True y bloquea, en vez de asumir que la grúa no
+    está.
+    """
+    return getattr(case, "caneinsite", True) is False
+
+
+def is_collision_case_eligible(data: dict, case) -> tuple:
+    """Evalúa las reglas de elegibilidad de colisión.
+
+    Devuelve (elegible, motivo). El motivo es para trazabilidad: dice qué
+    regla bloqueó el despacho automático.
+    """
+    car_type = (data or {}).get("car_type")
+    if not is_vehicle_type_allowed(car_type):
+        return False, "tipo de vehículo no permitido para asignación automática"
+
+    if not is_destination_type_allowed(getattr(case, "destination_type", None)):
+        return False, "tipo de destino no permitido para asignación automática"
+
+    if not is_crane_absent(case):
+        return False, "la grúa ya se encuentra en el lugar"
+
+    sinister = getattr(case, "sinister", None)
+    applicant_type = getattr(sinister, "applicant_type", None) if sinister else None
+    if not is_applicant_type_allowed(applicant_type):
+        return False, "tipo de solicitante no permitido para asignación automática"
+
+    return True, ""
