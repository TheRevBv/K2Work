+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from ix.apps.automatic_closing.strategies import AutomaticClosingProcess as module
+from ix.apps.automatic_closing.strategies.AutomaticClosingProcess import AutomaticClosingProcess
+
+
+def _process(service_id):
+    process = AutomaticClosingProcess.__new__(AutomaticClosingProcess)
+    process.data = SimpleNamespace(
+        case_id=1, from_ahio_automatic_closing=False, from_case_canceled=False
+    )
+    process.ticket = SimpleNamespace(service_id=service_id)
+    return process
+
