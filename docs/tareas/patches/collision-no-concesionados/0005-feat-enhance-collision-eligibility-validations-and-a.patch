@@ -1,4 +1,5 @@
 import re
+import unicodedata
 
 from flask import g
 
@@ -26,12 +27,41 @@ JUMPSTART_SUFFICIENT_RE = (
     r"para que arranque su vehículo\?\s*(Si|No)"
 )
 
+VEHICLE_FRONT_FACING_RE = r"(?:\d+\.\s*)?¿El frente del vehículo esta hacia alguna\?\s*(.+?)(?:\n|$)"
+
+# El label del dropdown Angular (pregunta7siniestro) es "Pared/obstrucción",
+# pero los datos reales (casos 66691 y 66726, confirmados en DB 2026-09-07)
+# guardan el cuestionario con la respuesta como "Pared" a secas — el flujo de
+# "Boleta creada por operador" no manda el label completo. Se compara con
+# startswith("pared") tras normalizar para cubrir ambas variantes sin
+# depender de cuál llegue.
+
+VEHICLE_LOCATION_RE = r"(?:\d+\.\s*)?¿Dónde se encuentra el vehículo\?\s*(.+?)(?:\n|$)"
+VEHICLE_CARGO_RE = r"(?:\d+\.\s*)?¿Tiene algún tipo de carga\?\s*(Si|No|Sí)"
+
 
 def _match_group(pattern: str, comment: str, flags=re.IGNORECASE | re.DOTALL):
     match = re.search(pattern, comment, flags)
     return match.group(1) if match else None
 
 
+def _normalize_no_accents(value: str) -> str:
+    normalized = unicodedata.normalize("NFD", value or "")
+    return normalized.encode("ascii", "ignore").decode("ascii").strip().lower()
+
+
+# Texto real de la opción en el formulario Angular (pregunta5siniestro):
+# "Estacionamiento – Nivel" (en-dash, con espacios) — no "Estacionamiento/Nivel"
+# ni "Estacionamiento" a secas. "Barranco" y "Túnel" también son opciones
+# reales de este campo pero QA no las marcó como bloqueantes: se dejan
+# fuera del set (fail-open) hasta tener evidencia o definición de negocio.
+# Nota (discrepancia detectada vs. plan): el literal "estacionamiento – nivel"
+# no matcheaba tras _normalize_no_accents porque el en-dash se elimina por
+# completo al codificar a ascii (no es un acento NFD) — se normaliza el
+# valor real aquí mismo para que la comparación sea consistente.
+BLOCKED_VEHICLE_LOCATIONS = {_normalize_no_accents("Estacionamiento – Nivel")}
+
+
 def _is_heavy_equipment(comment: str) -> bool:
     match_group = _match_group(HEAVY_EQUIPMENT_RE, comment) or ""
     return match_group.lower() in {"si", "sí", "yes"}
@@ -98,12 +128,46 @@ def _has_special_maneuver(case_id) -> bool:
     ).first() is not None
 
 
-def _validate_truck_collision(data: dict) -> bool:
+def _validate_vehicle_front_facing(comment: str) -> bool:
+    """RN colisión (QA CP-32/CP-33): "Pared" (o "Pared/obstrucción") bloquea,
+    cualquier otra respuesta (incluida ausencia de la pregunta) no bloquea."""
+    facing = _match_group(VEHICLE_FRONT_FACING_RE, comment)
+    if facing is None:
+        return True
+    return not _normalize_no_accents(facing).startswith("pared")
+
+
+def _validate_vehicle_location(comment: str) -> bool:
+    """RN colisión (QA CP-34 a CP-37): "Estacionamiento – Nivel" bloquea."""
+    location = _match_group(VEHICLE_LOCATION_RE, comment)
+    if location is None:
+        return True
+    return _normalize_no_accents(location) not in BLOCKED_VEHICLE_LOCATIONS
+
+
+def _validate_vehicle_cargo(comment: str) -> bool:
+    """RN colisión (QA CP-38/CP-39): transportar carga bloquea."""
+    cargo = _match_group(VEHICLE_CARGO_RE, comment)
+    if cargo is None:
+        return True
+    return _normalize_no_accents(cargo) != "si"
+
+
+def _validate_truck_collision(comment: str, data: dict) -> bool:
     # El tipo de vehículo se valida con la lista blanca de
-    # apps/ahio/collision_eligibility.py. Aquí solo queda la maniobra:
-    # la maniobra especial requiere envío de fotos, que Qonect aún no
-    # soporta.
-    return not _has_special_maneuver(data.get("case_id"))
+    # apps/ahio/collision_eligibility.py. Aquí queda la maniobra (requiere
+    # fotos que Qonect aún no soporta) y las respuestas del cuestionario
+    # de colisión que sí bloquean (QA CP-32 a CP-39): frente hacia pared,
+    # vehículo en estacionamiento/nivel, o con carga.
+    if _has_special_maneuver(data.get("case_id")):
+        return False
+    if not _validate_vehicle_front_facing(comment):
+        return False
+    if not _validate_vehicle_location(comment):
+        return False
+    if not _validate_vehicle_cargo(comment):
+        return False
+    return True
 
 
 def validate_qonect_questionnaire(service_id: int, comment: str, data: dict) -> bool:
@@ -115,7 +179,7 @@ def validate_qonect_questionnaire(service_id: int, comment: str, data: dict) ->
         return _validate_crane(comment)
 
     if service_id == SERVICE_TRUCK_COLLISION:
-        return _validate_truck_collision(data)
+        return _validate_truck_collision(comment, data)
 
     if service_id == SERVICE_TIRE_CHANGE:
         return _validate_tire_change(comment)
